{
  "expo": {
    "name": "SportLink",
    "slug": "sportlink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/icon-512.png",
    "scheme": "sportlink",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "permissions": ["READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cette app a besoin d'accéder à vos photos pour sauvegarder les fichiers téléchargés."
      }
    },
    "android": {
      "icon": "./src/assets/images/icon-512.png",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/images/favicon.png",
      "icons": [
        {
          "src": "./src/assets/images/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        },
        {
          "src": "./src/assets/images/icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "name": "SportLink",
      "build": {
        "babel": {
          "include": ["expo-file-system", "expo-sharing"]
        }
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
